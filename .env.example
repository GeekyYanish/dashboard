# Browser-visible website origin used for the staff authentication handoff.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Server-only backend origin used by the console proxy and SSO callback.
REGISTRATION_API_URL=http://127.0.0.1:4000

# Keep the live console on backend-backed repositories. Set false only for
# isolated local UI demos; that mode is not an authentication boundary.
NEXT_PUBLIC_USE_API_BACKEND=true
