
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3002

# Server-only backend origin used by the console proxy and SSO callback.
# Local development runs gateways_dev_backend on 5001; a deployed console points
# this at the hosted API instead (see "Hosted deployment" below).
REGISTRATION_API_URL=http://127.0.0.1:5001

# Keep the live console on backend-backed repositories. Set false only for
# isolated local UI demos; that mode is not an authentication boundary.
NEXT_PUBLIC_USE_API_BACKEND=true

# ── Hosted deployment ────────────────────────────────────────────────────────
# The same three variables, set on the Vercel project rather than in a file:
#
#   REGISTRATION_API_URL=https://<the-api-deployment>.vercel.app
#   NEXT_PUBLIC_WEBSITE_URL=https://gateways-preprod.vercel.app
#   NEXT_PUBLIC_USE_API_BACKEND=true
#
# REGISTRATION_API_URL has no NEXT_PUBLIC_ prefix on purpose: the browser only
# ever calls same-origin /api/v1/*, and src/app/api/v1/[...path]/route.ts makes
# the cross-origin call server-side. The backend address never reaches client
# code, and there is no CORS surface to configure.
#
# The API deployment must NOT have Vercel deployment protection enabled. A
# protected deployment answers with an SSO login page instead of JSON, which the
# proxy reports as a 503 STORAGE_UNAVAILABLE — every screen then renders its
# empty state with nothing indicating the real cause.
